<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_8dp"
        android:backgroundTint="#E2E8F0" />

    <!-- Sheet Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/flSheetIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_blue">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_privacy_shield"
                app:tint="#1A6FD4" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/flSheetIcon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dispute Details"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#6B7280"
                android:textSize="12sp"
                tools:text="Order #72a9092c" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/shape_close_btn_bg"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="#6B7280" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Customer Issue Header with Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CUSTOMER ISSUE"
                    android:textColor="#6B7280"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSheetQtyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_rounded_8dp"
                    android:backgroundTint="#FFFBEB"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="#B45309"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Qty: 2" />

                <TextView
                    android:id="@+id/tvSheetRefundBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_8dp"
                    android:backgroundTint="#ECFDF5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="#047857"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Refund: ₹850" />
            </LinearLayout>

            <!-- Customer Reason Text Bubble -->
            <TextView
                android:id="@+id/tvSheetReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_8dp"
                android:backgroundTint="#F3F4F6"
                android:lineSpacingMultiplier="1.2"
                android:padding="12dp"
                android:textColor="#1F2937"
                android:textSize="13.5sp"
                tools:text="Received wrong item size and color not matching order." />

            <!-- Evidence Images Container -->
            <LinearLayout
                android:id="@+id/layoutSheetEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evidence Photos"
                    android:textColor="#6B7280"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/containerSheetEvidenceImages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Previous Seller Response -->
            <LinearLayout
                android:id="@+id/layoutSheetPreviousResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR RESPONSE"
                    android:textColor="#1A6FD4"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSheetSellerResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_rounded_8dp"
                    android:backgroundTint="#EFF6FF"
                    android:padding="12dp"
                    android:textColor="#1E40AF"
                    android:textSize="13.5sp"
                    tools:text="We have checked our inventory and verified the issue. Refund approved." />
            </LinearLayout>

            <!-- Admin Resolution -->
            <LinearLayout
                android:id="@+id/layoutSheetAdminResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADMIN RESOLUTION"
                    android:textColor="#059669"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSheetAdminResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_rounded_8dp"
                    android:backgroundTint="#ECFDF5"
                    android:padding="12dp"
                    android:textColor="#065F46"
                    android:textSize="13.5sp"
                    tools:text="Admin resolved dispute: Customer refunded from source." />
            </LinearLayout>

            <!-- Response Form (Only for Open disputes) -->
            <LinearLayout
                android:id="@+id/layoutSheetResponseForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality Check Status"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- QC Status Radio Buttons Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnQcPending"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_8dp"
                        android:backgroundTint="#EFF6FF"
                        android:gravity="center"
                        android:text="Pending"
                        android:textColor="#1A6FD4"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQcPassed"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_8dp"
                        android:backgroundTint="#F3F4F6"
                        android:gravity="center"
                        android:text="Passed QC"
                        android:textColor="#4B5563"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnQcFailed"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_8dp"
                        android:backgroundTint="#F3F4F6"
                        android:gravity="center"
                        android:text="Failed QC"
                        android:textColor="#4B5563"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Your Resolution / Explanation"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSheetResponse"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_seller_input"
                    android:gravity="top|start"
                    android:hint="Provide a helpful resolution or explanation..."
                    android:padding="12dp"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvSheetError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#DC2626"
                    android:textSize="11.5sp"
                    android:visibility="gone"
                    tools:text="Response must be at least 5 characters"
                    tools:visibility="visible" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSheetCancel"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#D1D5DB" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1.6">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSheetSubmit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Send Resolution"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="#1A6FD4"
                            app:cornerRadius="10dp" />

                        <ProgressBar
                            android:id="@+id/progressSheetSubmit"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
