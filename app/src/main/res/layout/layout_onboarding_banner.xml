<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvOnboardingBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/seller_warning_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/seller_warning"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivWarningIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_baseline_warning_amber_24"
            app:tint="@color/seller_warning"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOnboardingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Finish setting up your account"
            android:textColor="@color/seller_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivWarningIcon"
            app:layout_constraintTop_toTopOf="@id/ivWarningIcon"
            app:layout_constraintBottom_toBottomOf="@id/ivWarningIcon"
            app:layout_constraintEnd_toStartOf="@+id/tvOnboardingProgress" />

        <TextView
            android:id="@+id/tvOnboardingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="3 of 5 done"
            android:textColor="@color/seller_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvOnboardingTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvOnboardingTitle" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pbOnboarding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:indicatorColor="@color/seller_warning"
            app:trackColor="#E5E7EB"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            tools:progress="60"
            app:layout_constraintTop_toBottomOf="@id/tvOnboardingTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
