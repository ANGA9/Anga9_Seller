<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_commission_purple"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <!-- Left side: Text -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Platform commission"
            android:textColor="#7C3AED"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fee deducted from wholesale price when sold."
            android:textColor="#7C3AED"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Right side: Percentage and Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvCommissionRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#7C3AED"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnCommissionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_commission_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:backgroundTint="#F5EEFF"
            android:clickable="true"
            android:focusable="true">
            
            <TextView
                android:id="@+id/tvCommissionType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOADING"
                android:textColor="#7C3AED"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textAllCaps="true" />
                
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_info"
                app:tint="#7C3AED"
                android:layout_marginStart="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
