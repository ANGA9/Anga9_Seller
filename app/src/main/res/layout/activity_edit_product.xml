<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Link -->
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_back"
                app:tint="#5B6472" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to products"
                android:textColor="#5B6472"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Product"
            android:textColor="#1A1D23"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update your product details below"
            android:textColor="#5B6472"
            android:textSize="12sp" />
            
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E5E7EB"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="-14dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section: Basic Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_document"
                    app:tint="#2851C4"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Basic Details"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A1D23"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product name *"
                        android:textSize="12sp"
                        android:textColor="#5B6472"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="#1A1D23"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description *"
                        android:textSize="12sp"
                        android:textColor="#5B6472"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="3"
                        android:lines="3"
                        android:gravity="top"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="#1A1D23"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tvCategoryLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categories * (0/5)"
                        android:textSize="12sp"
                        android:textColor="#1A1D23"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                        
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacing="8dp">
                        <!-- Chips added dynamically -->
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section: Pricing & Inventory -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_tag"
                    app:tint="#2851C4"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pricing &amp; Inventory"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A1D23"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="5dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MRP (₹) *"
                                android:textSize="12sp"
                                android:textColor="#5B6472"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMrp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:background="@drawable/input_background"
                                android:padding="12dp"
                                android:textSize="14sp"
                                android:textColor="#1A1D23"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Maximum retail price printed on the pack."
                                android:textSize="10sp"
                                android:textColor="#9AA1AC"
                                android:layout_marginTop="4dp"
                                android:lines="2"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="5dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wholesale price (₹) *"
                                android:textSize="12sp"
                                android:textColor="#5B6472"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWholesalePrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:background="@drawable/input_background"
                                android:padding="12dp"
                                android:textSize="14sp"
                                android:textColor="#1A1D23"/>
                            <TextView
                                android:id="@+id/tvWholesaleHelper"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Buyer's per-unit price. Cannot exceed MRP."
                                android:textSize="10sp"
                                android:textColor="#9AA1AC"
                                android:layout_marginTop="4dp"
                                android:lines="2"/>
                        </LinearLayout>
                    </LinearLayout>

                    <include layout="@layout/layout_commission_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="5dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Min order qty *"
                                android:textSize="12sp"
                                android:textColor="#5B6472"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMinOrderQty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:background="@drawable/input_background"
                                android:padding="12dp"
                                android:textSize="14sp"
                                android:textColor="#1A1D23"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="5dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unit *"
                                android:textSize="12sp"
                                android:textColor="#5B6472"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>
                            
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/input_background">
                                <Spinner
                                    android:id="@+id/spinnerUnit"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="44dp"
                                    android:padding="0dp" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section: Tags & HSN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_document"
                    app:tint="#2851C4"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tags &amp; HSN"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A1D23"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search tags"
                        android:textSize="12sp"
                        android:textColor="#5B6472"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="#1A1D23"
                        android:hint="Comma separated tags"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Up to 10 tags to help buyers find your product."
                        android:textSize="10sp"
                        android:textColor="#9AA1AC"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HSN code"
                            android:textSize="12sp"
                            android:textColor="#5B6472"
                            android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/ivHsnInfo"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_info"
                            app:tint="#9AA1AC"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHsnCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="#1A1D23"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <include layout="@layout/layout_save_updates_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btnSaveChanges"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:backgroundTint="#2851C4"
                    android:textColor="#FFFFFF"
                    android:text="Save changes"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF"/>
                    
                <ProgressBar
                    android:id="@+id/pbSaving"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:elevation="2dp"
                    android:indeterminateTint="#FFFFFF"/>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
