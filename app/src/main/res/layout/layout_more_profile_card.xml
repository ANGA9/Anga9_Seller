<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProfileSummary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/more_card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/more_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_more_avatar"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="JD" />

        <TextView
            android:id="@+id/tvStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/more_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tvSellerId"
            app:layout_constraintStart_toEndOf="@id/tvAvatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Super Store" />

        <ImageView
            android:id="@+id/ivVerifiedBadge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_baseline_verified_24"
            app:tint="@color/status_approved"
            app:layout_constraintBottom_toBottomOf="@id/tvStoreName"
            app:layout_constraintStart_toEndOf="@id/tvStoreName"
            app:layout_constraintTop_toTopOf="@id/tvStoreName"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvSellerId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/more_text_muted"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvStoreName"
            tools:text="ID: SELL-12345" />

        <ImageView
            android:id="@+id/ivProfileChevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_more_chevron_right"
            app:tint="@color/more_text_muted"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Skeleton Loading Views (Overlaid) -->
        <View
            android:id="@+id/viewSkeletonAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_more_avatar"
            android:backgroundTint="@color/more_divider"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewSkeletonName"
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:background="@color/more_divider"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/viewSkeletonId"
            app:layout_constraintStart_toEndOf="@id/viewSkeletonAvatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <View
            android:id="@+id/viewSkeletonId"
            android:layout_width="80dp"
            android:layout_height="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:background="@color/more_divider"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewSkeletonAvatar"
            app:layout_constraintTop_toBottomOf="@id/viewSkeletonName" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
