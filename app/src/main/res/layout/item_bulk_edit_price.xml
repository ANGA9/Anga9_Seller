<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_ticket_card"
    android:padding="16dp">

    <!-- Product Name -->
    <TextView
        android:id="@+id/tvProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="#111827"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvEditedBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Premium Organic Honey 500g" />

    <!-- Edited Badge -->
    <TextView
        android:id="@+id/tvEditedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="#EFF6FF"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="Edited"
        android:textColor="#1D4ED8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/llInputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvProductName">

        <!-- Base Price -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Base ₹"
                android:textColor="#4B5563"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBasePrice"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_ticket_card"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="#111827"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Sale Price -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Sale ₹"
                android:textColor="#4B5563"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSalePrice"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_ticket_card"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="#111827"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sale price must be lower than base price"
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llInputs"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvDiscountBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="#F3F4F6"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#4B5563"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvError"
        tools:text="15% off"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
