<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Customer Reviews"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvTotalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Rating Summary Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <!-- Left: Big rating number -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tvAvgRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvStarDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★★"
                    android:textSize="16sp"
                    android:textColor="#F59E0B"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvRatingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ratings"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="100dp"
                android:background="#E2E8F0" />

            <!-- Right: Rating bars -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp">

                <!-- 5 star -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                        android:text="5" android:textSize="11sp" android:textColor="#64748B" />
                    <ProgressBar android:id="@+id/bar5" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:progressTint="#F59E0B" android:progressBackgroundTint="#F1F5F9"
                        android:max="100" android:progress="0" />
                    <TextView android:id="@+id/tvPct5" android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="10sp" android:textColor="#94A3B8" android:gravity="end" />
                </LinearLayout>

                <!-- 4 star -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                        android:text="4" android:textSize="11sp" android:textColor="#64748B" />
                    <ProgressBar android:id="@+id/bar4" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:progressTint="#F59E0B" android:progressBackgroundTint="#F1F5F9"
                        android:max="100" android:progress="0" />
                    <TextView android:id="@+id/tvPct4" android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="10sp" android:textColor="#94A3B8" android:gravity="end" />
                </LinearLayout>

                <!-- 3 star -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                        android:text="3" android:textSize="11sp" android:textColor="#64748B" />
                    <ProgressBar android:id="@+id/bar3" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:progressTint="#F59E0B" android:progressBackgroundTint="#F1F5F9"
                        android:max="100" android:progress="0" />
                    <TextView android:id="@+id/tvPct3" android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="10sp" android:textColor="#94A3B8" android:gravity="end" />
                </LinearLayout>

                <!-- 2 star -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                        android:text="2" android:textSize="11sp" android:textColor="#64748B" />
                    <ProgressBar android:id="@+id/bar2" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:progressTint="#F59E0B" android:progressBackgroundTint="#F1F5F9"
                        android:max="100" android:progress="0" />
                    <TextView android:id="@+id/tvPct2" android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="10sp" android:textColor="#94A3B8" android:gravity="end" />
                </LinearLayout>

                <!-- 1 star -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                        android:text="1" android:textSize="11sp" android:textColor="#64748B" />
                    <ProgressBar android:id="@+id/bar1" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:progressTint="#EF4444" android:progressBackgroundTint="#F1F5F9"
                        android:max="100" android:progress="0" />
                    <TextView android:id="@+id/tvPct1" android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="10sp" android:textColor="#94A3B8" android:gravity="end" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/chipAll"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:text="All"
                android:textSize="13sp" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/btn_primary_rounded" android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/chip5"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:text="★ 5"
                android:textSize="13sp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/input_background" android:textColor="#475569"
                android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/chip4"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:text="★ 4"
                android:textSize="13sp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/input_background" android:textColor="#475569"
                android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/chip3"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:text="★ 3"
                android:textSize="13sp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/input_background" android:textColor="#475569"
                android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/chipCritical"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:text="Critical (1-2)"
                android:textSize="13sp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/input_background" android:textColor="#475569"
                android:clickable="true" android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="★" android:textSize="48sp" android:textColor="#CBD5E1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="No reviews yet"
            android:textColor="#94A3B8" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Reviews will appear here once customers rate your products"
            android:textColor="#CBD5E1" android:textSize="13sp" android:gravity="center"
            android:paddingStart="32dp" android:paddingEnd="32dp" />

    </LinearLayout>

    <!-- Reviews list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReviews"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
