<?xml version="1.0" encoding="utf-8"?>
<!--
    Single brand row in the brand switcher list
    Plan ref: MULTI_BRAND_MANAGEMENT_IMPLEMENTATION_PLAN.md - Phase 2.2
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Brand logo initial circle -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp">

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/category_icon_bg" />

        <TextView
            android:id="@+id/tvBrandInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Brand name + slug -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBrandSlug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Active checkmark -->
    <ImageView
        android:id="@+id/ivActiveCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_check"
        android:tint="@color/accent"
        android:visibility="gone"
        android:contentDescription="Active brand" />

</LinearLayout>
