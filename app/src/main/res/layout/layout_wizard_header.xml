<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/btnWizardBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:tint="@color/wizard_text_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Product"
            android:textColor="@color/wizard_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWizardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1 of 5 · Media &amp; Imagery"
            android:textColor="@color/wizard_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSaveDraft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save draft"
        android:textColor="@color/wizard_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
