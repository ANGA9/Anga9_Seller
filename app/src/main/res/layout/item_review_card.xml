<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:layout_marginBottom="16dp"
    android:padding="16dp">

    <!-- Top Row: Rating and Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Custom Star Rating Container -->
        <LinearLayout
            android:id="@+id/llStarRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- 5 ImageViews will be added programmatically or toggled -->
            <ImageView android:id="@+id/ivStar1" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star_filled" app:tint="#FBBF24"/>
            <ImageView android:id="@+id/ivStar2" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star_filled" app:tint="#FBBF24" android:layout_marginStart="2dp"/>
            <ImageView android:id="@+id/ivStar3" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star_filled" app:tint="#FBBF24" android:layout_marginStart="2dp"/>
            <ImageView android:id="@+id/ivStar4" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star_filled" app:tint="#FBBF24" android:layout_marginStart="2dp"/>
            <ImageView android:id="@+id/ivStar5" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star_outline" app:tint="#D1D5DB" android:layout_marginStart="2dp"/>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 24, 2024"
            android:textColor="#6B7280"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="By John Doe"
        android:textColor="#374151"
        android:textSize="12sp"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/tvReviewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Great product!"
        android:textColor="#111827"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvReviewBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I really liked this product. It works perfectly and the quality is amazing."
        android:textColor="#4B5563"
        android:textSize="14sp"
        android:textStyle="italic"
        android:layout_marginTop="4dp" />

    <!-- Product Reference Row -->
    <LinearLayout
        android:id="@+id/llProductRef"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:background="#F9FAFB"
        android:padding="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProductThumb"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_image_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"/>

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Premium Wireless Headphones"
            android:textColor="#374151"
            android:textSize="13sp"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#9CA3AF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
