<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wizard_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/wizard_input_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Photos"
                        android:textColor="@color/wizard_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:id="@+id/tvImageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0/10 selected"
                        android:textColor="@color/wizard_text_muted"
                        android:textSize="12sp" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Portrait images (4:5), min 1000x1250px, under 5MB each. First photo is your cover image."
                    android:textColor="@color/wizard_text_secondary"
                    android:textSize="12sp" />

                <!-- Grid for images (simulated with RecyclerView) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />
                    
                <Button
                    android:id="@+id/btnAddImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Select Photos"
                    android:textColor="@color/wizard_accent"
                    android:backgroundTint="@color/wizard_accent_bg"
                    style="?attr/materialButtonOutlinedStyle"
                    app:strokeWidth="0dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/wizard_input_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Videos"
                        android:textColor="@color/wizard_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:id="@+id/tvVideoCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0/2 selected"
                        android:textColor="@color/wizard_text_muted"
                        android:textSize="12sp" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Under 60 seconds, under 50MB."
                    android:textColor="@color/wizard_text_secondary"
                    android:textSize="12sp" />

                <!-- Grid for videos -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVideos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />
                    
                <Button
                    android:id="@+id/btnAddVideos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Select Videos"
                    android:textColor="@color/wizard_text_primary"
                    android:backgroundTint="@color/wizard_disabled_bg"
                    style="?attr/materialButtonOutlinedStyle"
                    app:strokeWidth="0dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <include layout="@layout/layout_info_tip_card" />

    </LinearLayout>
</ScrollView>
