<?xml version="1.0" encoding="utf-8"?>
<!--
    Horizontal attachment preview strip item
    Used in:
    1. CreateTicketActivity → rvAttachments (selected files before submit)
    2. TicketDetailActivity → rvReplyAttachments (selected files before send)

    Shows:
    - Image files: thumbnail (Coil)
    - Non-image files: file icon + short filename
    - Remove (×) button on top-right corner
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:layout_marginEnd="8dp">

    <!-- Image thumbnail (for image/* files) -->
    <ImageView
        android:id="@+id/ivPreviewThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/input_field_bg"
        android:visibility="gone"
        android:contentDescription="Selected image" />

    <!-- File chip (for non-image files) -->
    <LinearLayout
        android:id="@+id/layoutFileChip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/input_field_bg"
        android:padding="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivFileTypeIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_attachment"
            android:contentDescription="File"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tvFileExt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=".pdf"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Remove button (×) — top-right corner -->
    <ImageView
        android:id="@+id/btnRemove"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/circle_remove_bg"
        android:contentDescription="Remove attachment"
        android:padding="3dp" />
</FrameLayout>
