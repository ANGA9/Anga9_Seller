<?xml version="1.0" encoding="utf-8"?>
<!--
    CSAT Rating Dialog — Phase 4
    Shown once after ticket is marked resolved.
    - 1-5 star rating (tap to select)
    - Optional comment field
    - Submit → POST /tickets/:id/rate
    - Skip button (dismisses without submitting)
    - Tracked in SharedPreferences by ticket ID (shown only once)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Header icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="😊"
        android:textSize="40sp" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="How was your experience?"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Rate your support experience"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center" />

    <!-- Star rating row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStar1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="1 star"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/ivStar2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="2 stars"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/ivStar3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="3 stars"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/ivStar4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="4 stars"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/ivStar5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="5 stars"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Star labels -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="Poor"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="Great"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Optional comment -->
    <EditText
        android:id="@+id/etCsatComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/input_field_bg"
        android:hint="Tell us more (optional)"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:gravity="top|start" />

    <!-- Submit button -->
    <Button
        android:id="@+id/btnSubmitRating"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Submit Feedback"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary" />

    <!-- Skip link -->
    <TextView
        android:id="@+id/btnSkipRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="Skip"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />
</LinearLayout>
