<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wizard_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/wizard_input_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Return Policy *"
                    android:textColor="@color/wizard_text_secondary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerReturnPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Applies to all your listings unless changed per product."
                    android:textColor="@color/wizard_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Warranty Information"
                    android:textColor="@color/wizard_text_secondary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerWarranty"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomWarranty"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Specify Custom Warranty"
                    android:visibility="gone"
                    app:boxStrokeColor="@color/wizard_input_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomWarranty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/wizard_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Search Tags"
                    android:textColor="@color/wizard_text_secondary"
                    android:textSize="12sp" />
                    
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearchTags"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Add tag and press enter"
                    app:helperText="Helps buyers find this in search. 3-8 tags work best."
                    app:boxStrokeColor="@color/wizard_input_border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchTagsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:textColor="@color/wizard_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Final Summary Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFinalSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            android:layout_marginVertical="16dp"
            app:cardBackgroundColor="@color/wizard_success_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivSummaryIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/wizard_success_text" />

                <TextView
                    android:id="@+id/tvSummaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All required fields across 5 steps are complete. Your listing will be reviewed within 24-48 hours after submission."
                    android:textColor="@color/wizard_success_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
