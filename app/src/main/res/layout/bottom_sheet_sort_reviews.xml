<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sort Reviews"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/rgSortOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbNewest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Newest First"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/rbRatingDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Highest Rated"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/rbRatingAsc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lowest Rated"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/rbHelpful"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Most Helpful"
            android:textSize="15sp"
            android:padding="12dp" />
    </RadioGroup>

</LinearLayout>
